MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf", "png", "jpeg", "jpg", "tiff", "docx", "zip"]
RATE_LIMIT_PER_MINUTE=60

GEMINI_API_KEY=""
GROQ_API_KEY=""
