APP_NAME="AI Multilingual Document Translation & Intelligence System"
DEBUG=True
HOST=0.0.0.0
PORT=8000

UPLOAD_DIR="./uploads"
TRANSLATED_DIR="./translated"
LOG_DIR="./logs"

DATABASE_URL="sqlite+aiosqlite:///./gov_doc_translation.db"
